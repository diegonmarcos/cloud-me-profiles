{
  "name": "Social",
  "framework": "vanilla",
  "port": 8014,
  "src": "src",
  "dist": "dist",
  "build": [
    {"_doc": "Wrap src/data/*.json as globalThis.PORTAL_DATA companions (data-*.json.js).", "mod": "data_wrap", "dir": "src/data"},
    {"mod": "copy", "files": "data-*.json.js", "from": "src/data"},
    {"mod": "copy", "files": "*.html", "from": "src"},
    {"mod": "symlink", "files": "public"}
  ],
  "serve": {"mode": "auto", "dir": "src"},
  "deploy": {}
}
